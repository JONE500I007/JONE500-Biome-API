{
	"schemaVersion": 1,
	"id": "jone500-biome-api",
	"version": "${version}",
	"name": "JONE500 Biome API",
	"description": "A library for adding Overworld, Nether and End biomes in regions that are deterministic (sorted by id), with per-patch chances, weighted biomes, world-wide replacements and surface rules.",
	"contact": {
		"homepage": "https://github.com/JONE500I007/JONE500-Biome-API",
		"sources": "https://github.com/JONE500I007/JONE500-Biome-API",
		"issues": "https://github.com/JONE500I007/JONE500-Biome-API/issues"
	},
	"authors": [
		"JONE500"
	],
	"license": "MIT",
	"icon": "assets/jone500-biome-api/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.biome.api.JONE500BiomeAPI"
		]
	},
	"mixins": [
		"jone500-biome-api.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"custom": {
		"modmenu": {
			"badges": ["library"]
		}
	}
}
